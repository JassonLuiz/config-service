<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Configuração do Checkstyle para Java 21 + Spring Boot
    Baseado no Google Java Style Guide (simplificado para desafio)
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- Tamanho máximo de linha -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    </module>

    <module name="TreeWalker">

        <!-- ===== IMPORTS ===== -->
        <!-- Proíbe imports com wildcard (ex: import java.util.*) -->
        <module name="AvoidStarImport"/>
        <!-- Proíbe imports não utilizados -->
        <module name="UnusedImports"/>
        <!-- Ordena imports -->
        <module name="ImportOrder">
            <property name="option" value="bottom"/>
            <property name="separatedStaticGroups" value="true"/>
        </module>

        <!-- ===== NOMENCLATURA ===== -->
        <!-- Nome de classes em PascalCase -->
        <module name="TypeName"/>
        <!-- Nome de métodos em camelCase -->
        <module name="MethodName"/>
        <!-- Nome de variáveis em camelCase -->
        <module name="LocalVariableName"/>
        <!-- Constantes em UPPER_CASE -->
        <module name="ConstantName"/>
        <!-- Parâmetros em camelCase -->
        <module name="ParameterName"/>

        <!-- ===== BOAS PRÁTICAS ===== -->
        <!-- Proíbe blocos catch vazios -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignore"/>
        </module>
        <!-- Exige chaves em blocos if/else/for/while -->
        <module name="NeedBraces"/>
        <!-- Proíbe uso de == com String -->
        <module name="StringLiteralEquality"/>
        <!-- Limita complexidade ciclomática -->
        <module name="CyclomaticComplexity">
            <property name="max" value="10"/>
        </module>

        <!-- ===== FORMATAÇÃO ===== -->
        <!-- Espaço após vírgulas -->
        <module name="WhitespaceAfter"/>
        <!-- Sem espaço antes de vírgulas -->
        <module name="NoWhitespaceBefore"/>
        <!-- Chave de abertura na mesma linha -->
        <module name="LeftCurly"/>
        <!-- Chave de fechamento em linha própria -->
        <module name="RightCurly"/>

    </module>
</module>