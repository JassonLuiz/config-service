# Copie para .env e ajuste conforme necessario: cp .env.example .env

# Postgres
POSTGRES_DB=configdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Hostname/IP anunciado pelo Kafka para clientes fora do Docker.
# Use "localhost" para desenvolvimento local ou o IP da maquina para acesso remoto.
KAFKA_ADVERTISED_HOST=localhost

# Credenciais da API de configuracao
CONFIG_ADMIN_USERNAME=admin
CONFIG_ADMIN_PASSWORD=admin123

# Namespace/ambiente usados pela aplicacao demonstrativa
CONFIG_NAMESPACE=my-app
CONFIG_ENVIRONMENT=dev
